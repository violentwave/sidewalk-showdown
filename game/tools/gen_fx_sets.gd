# One-shot data generator: builds the per-fighter FxSet resources from
# art/source/FX/hit_fx/fx_manifest.json so the sheet metadata can never drift
# from the owner-approved art. Re-run after the manifest changes; the fighter
# .tres files reference the saved resources and are NOT regenerated by this
# tool (see the gen_fighter_data.gd note).
#
#   godot --headless --path game --script res://tools/gen_fx_sets.gd
extends SceneTree

const MANIFEST := "res://../art/source/FX/hit_fx/fx_manifest.json"
const OUT_DIR := "res://resources/fighters"

# Mirroring per sheet (design §1.5): directional streaks/bursts mirror with
# the attacker's facing, radial chips/splashes do not.
const PEGGY_MIRROR := {
	"peggy_special_hit_sheet": true,
	"peggy_ex_hit_sheet": true,
	"peggy_heavy_whoosh_sheet": true,
	"peggy_special_trail_sheet": true,
}
const RICHARD_MIRROR := {
	"richard_special_hit_sheet": true,
	"richard_ex_hit_sheet": true,
	"richard_heavy_whoosh_sheet": true,
	"richard_special_trail_sheet": true,
}


func _init() -> void:
	var manifest := _load_manifest()
	if manifest.is_empty():
		push_error("gen_fx_sets: manifest missing/invalid")
		quit(1)
		return
	_save(_peggy_set(manifest), "peggy_fx_set.tres")
	_save(_richard_set(manifest), "richard_fx_set.tres")
	print("fx set resources saved")
	quit()


func _load_manifest() -> Dictionary:
	var fs := FileAccess.open(MANIFEST, FileAccess.READ)
	if fs == null:
		return {}
	var parsed: Variant = JSON.parse_string(fs.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}
	return parsed


func _def(manifest: Dictionary, name: String, mirror_table: Dictionary) -> FxSheetDef:
	var entry: Dictionary = manifest.get(name, {})
	var d := FxSheetDef.new()
	d.texture_path = "res://art/fx/%s.png" % name
	d.frames = int(entry.get("frames", 1))
	d.ticks_per_frame = int(entry.get("ticks_per_frame", 2))
	var cell: Array = entry.get("cell", [32, 32])
	d.cell = Vector2i(int(cell[0]), int(cell[1]))
	d.mirror = bool(mirror_table.get(name, false))
	return d


func _peggy_set(manifest: Dictionary) -> FxSet:
	var s := FxSet.new()
	s.hit_light = _def(manifest, "peggy_hit_light_sheet", PEGGY_MIRROR)
	s.hit_heavy = _def(manifest, "peggy_hit_heavy_sheet", PEGGY_MIRROR)
	s.hit_counter = _def(manifest, "peggy_hit_counter_sheet", PEGGY_MIRROR)
	s.block = _def(manifest, "peggy_block_sheet", PEGGY_MIRROR)
	s.special_hit = _def(manifest, "peggy_special_hit_sheet", PEGGY_MIRROR)
	s.ex_hit = _def(manifest, "peggy_ex_hit_sheet", PEGGY_MIRROR)
	s.heavy_whoosh = _def(manifest, "peggy_heavy_whoosh_sheet", PEGGY_MIRROR)
	s.special_trail = _def(manifest, "peggy_special_trail_sheet", PEGGY_MIRROR)
	s.landing_dust = _def(manifest, "landing_dust_sheet", {})
	return s


func _richard_set(manifest: Dictionary) -> FxSet:
	var s := FxSet.new()
	s.hit_light = _def(manifest, "richard_hit_light_sheet", RICHARD_MIRROR)
	s.hit_heavy = _def(manifest, "richard_hit_heavy_sheet", RICHARD_MIRROR)
	s.hit_counter = _def(manifest, "richard_hit_counter_sheet", RICHARD_MIRROR)
	s.block = _def(manifest, "richard_block_sheet", RICHARD_MIRROR)
	s.special_hit = _def(manifest, "richard_special_hit_sheet", RICHARD_MIRROR)
	s.ex_hit = _def(manifest, "richard_ex_hit_sheet", RICHARD_MIRROR)
	s.heavy_whoosh = _def(manifest, "richard_heavy_whoosh_sheet", RICHARD_MIRROR)
	s.special_trail = _def(manifest, "richard_special_trail_sheet", RICHARD_MIRROR)
	s.landing_dust = _def(manifest, "landing_dust_sheet", {})
	return s


func _save(set: FxSet, file_name: String) -> void:
	var path := "%s/%s" % [OUT_DIR, file_name]
	var err := ResourceSaver.save(set, path)
	if err != OK:
		push_error("failed to save %s: %d" % [path, err])
